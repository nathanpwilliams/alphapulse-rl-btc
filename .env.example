# =============================================================================
# AlphaPulse RL Bot - Environment Variable Template
# =============================================================================
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit the real .env file.
#
#     cp .env.example .env
#     # then edit .env with your actual keys
#
# Load in Python via:
#     from dotenv import load_dotenv
#     load_dotenv()
#     import os
#     api_key = os.environ["KRAKEN_FUTURES_DEMO_API_KEY"]
# =============================================================================

# --- Kraken Futures Demo (testnet) ---
# Sign up: https://demo-futures.kraken.com
# Used for Phase 2 paper trading
KRAKEN_FUTURES_DEMO_API_KEY=
KRAKEN_FUTURES_DEMO_API_SECRET=

# --- Kraken Futures Live ---
# DO NOT FILL THESE UNTIL PHASE 3 (small live capital validation)
# Sign up: https://futures.kraken.com
KRAKEN_FUTURES_LIVE_API_KEY=
KRAKEN_FUTURES_LIVE_API_SECRET=

# --- Optional: backup data source for cross-checking ---
# Free tier sufficient for our use; get key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# --- Run configuration ---
# Set to "demo" or "live"; controls which Kraken endpoint code talks to
TRADING_MODE=demo
